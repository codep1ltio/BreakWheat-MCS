function levelCheck(p: player):
    if {points::%uuid of {_p}%} is higher or equal to {pointsReq::%uuid of {_p}%}:
        remove {pointsReq::%uuid of {_p}%} from {points::%uuid of {_p}%}
        set {pointsReq::%uuid of {_p}%} to {pointsReq::%uuid of {_p}%} * 1.1

        addToken({_p}, 1)
        send "&6+1 Token for leveling up!" to {_p}
        addLevel({_p}, 1)