function openUpgradeToolsMenu(p: player):
    set {_s} to chest inventory with 3 rows named "%{lang::%{-language::%uuid of {_p}%}%::upgradeTools}%"
    set slot 12 of {_s} to blaze powder named "<#4cedd8>%{lang::%{-language::%uuid of {_p}%}%::upgradeAbility}%" with lore "&8%{lang::%{-language::%uuid of {_p}%}%::usageUtility}%" and " " and {lang::%{-language::%uuid of {_p}%}%::rightclickopen}
    set slot 14 of {_s} to diamond hoe named "<#ed9a4c>%{lang::%{-language::%uuid of {_p}%}%::buyHoes}%" with lore "&8%{lang::%{-language::%uuid of {_p}%}%::usageUtility}%" and " " and {lang::%{-language::%uuid of {_p}%}%::rightclickopen}
    open {_s} to {_p}

function openHarvesterShop(p: player):
    set {_s} to chest inventory with 5 rows named "%{lang::%{-language::%uuid of {_p}%}%::harvesterShop}%"
    set slot 21 of {_s} to (lime stained glass pane) named "<#86e362>%{lang::%{-language::%uuid of {_p}%}%::purchase}%" with lore "&8%{lang::%{-language::%uuid of {_p}%}%::noConfirmation}%" and "" and "<#8aed4c>%{lang::%{-language::%uuid of {_p}%}%::price}%:   $%{hoes::%{-hoe::%uuid of {_p}%} + 1%::price}% &8(<#8aed4c>$%{-data::%uuid of {_p}%::balance}%&8)" and "<#edaa4c>%{lang::%{-language::%uuid of {_p}%}%::tokens}%: %{hoes::%{-hoe::%uuid of {_p}%} + 1%::tokens}% &8(<#edaa4c>%{-token::%uuid of {_p}%}%&8)" and "<#edda4c>%{lang::%{-language::%uuid of {_p}%}%::level}%:   %{hoes::%{-hoe::%uuid of {_p}%} + 1%::level}% &8(<#edda4c>%{-level::%uuid of {_p}%}%&8)"
    set slot 22 of {_s} to {hoes::%{-hoe::%uuid of {_p}%} + 1%} with lore {lang::%{-language::%uuid of {_p}%}%::requirements} and "<#8aed4c>%{lang::%{-language::%uuid of {_p}%}%::price}%:   $%{hoes::%{-hoe::%uuid of {_p}%} + 1%::price}%" and "<#edaa4c>%{lang::%{-language::%uuid of {_p}%}%::tokens}%: %{hoes::%{-hoe::%uuid of {_p}%} + 1%::tokens}%" and "<#edda4c>%{lang::%{-language::%uuid of {_p}%}%::level}%:   %{hoes::%{-hoe::%uuid of {_p}%} + 1%::level}%" and {lang::%{-language::%uuid of {_p}%}%::comparison} and "<#F48566>%{lang::%{-language::%uuid of {_p}%}%::blast}%: &f%{hoes::%{-hoe::%uuid of {_p}%}%::blast}% <#8aed4c>+ %{hoes::%{-hoe::%uuid of {_p}%} + 1%::blast} - {hoes::%{-hoe::%uuid of {_p}%}%::blast}% &f%{lang::%{-language::%uuid of {_p}%}%::blocks}%" and "<#45CF30>%{lang::%{-language::%uuid of {_p}%}%::mult}%: &fx%{hoes::%{-hoe::%uuid of {_p}%}%::mult}% <#8aed4c>+ %{hoes::%{-hoe::%uuid of {_p}%} + 1%::mult} - {hoes::%{-hoe::%uuid of {_p}%}%::mult}%"
    set slot 23 of {_s} to nether star named "<#4cd8ed>%{lang::%{-language::%uuid of {_p}%}%::viewallharvesters}%" with lore "&8%{lang::%{-language::%uuid of {_p}%}%::usageUtility}%" and " " and {lang::%{-language::%uuid of {_p}%}%::rightclickopen}
    open {_s} to {_p}