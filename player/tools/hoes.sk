    set {hoes::9::level} to 34

    # dont forget to change the value on the lore
    set {hoes::10} to unbreakable stone hoe named "<#a8a8a8>Slate Stone Harvester" with lore "&8Uncommon ★★☆☆☆☆☆" and " " and " &8• <#F48566>Blast: &f%{hoes::10::blast} + 1% block" and " &8&l| <#45CF30>Mult: &fx%{hoes::10::mult}%"
    wait 1 tick
    set {hoes::10::blast} to 0
