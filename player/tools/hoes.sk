    set {hoes::13::level} to 49

    # dont forget to change the value on the lore
    set {hoes::14} to unbreakable stone hoe named "<#6e6c6b>Flint Harvester" with lore "&8Uncommon ★★☆☆☆☆☆" and " " and " &8• <#F48566>Blast: &f%{hoes::14::blast} + 1% block" and " &8&l| <#45CF30>Mult: &fx%{hoes::14::mult}%"
    wait 1 tick
