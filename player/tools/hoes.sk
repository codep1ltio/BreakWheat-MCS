command giveHoe <player> <integer>:
    permission: op
    trigger:
        give {hoes::%arg-2%} to arg-1

on load:
    set {hoes::1} to unbreakable wooden hoe named "<#5c5730>Broken Harvester" with lore "&8Starter ☆☆☆☆☆☆☆" and " " and " &8• <#F48566>Blast: &f%{hoes::1::blast} + 1% block" and " &8&l| <#45CF30>Mult: &fx%{hoes::1::mult}%"
    wait 1 tick
    set {hoes::1::blast} to 0
    set {hoes::1::mult} to 1.05



    set {hoes::2} to unbreakable wooden hoe named "<#5e502d>Rotten Harvester" with lore "&8Common ★☆☆☆☆☆☆" and " " and " &8• <#F48566>Blast: &f%{hoes::2::blast} + 1% block" and " &8&l| <#45CF30>Mult: &fx%{hoes::2::mult}%"
    wait 1 tick
    set {hoes::2::blast} to 0
    set {hoes::2::mult} to 1.08
    
    set {hoes::2::price} to 1350
    set {hoes::2::tokens} to 1
    set {hoes::2::level} to 4



    set {hoes::3} to unbreakable wooden hoe named "<#cf7f29>Rusted Harvester" with lore "&8Common ★☆☆☆☆☆☆" and " " and " &8• <#F48566>Blast: &f%{hoes::3::blast} + 1% block" and " &8&l| <#45CF30>Mult: &fx%{hoes::3::mult}%"
    wait 1 tick
    set {hoes::3::blast} to 0
    set {hoes::3::mult} to 1.1

    set {hoes::3::price} to 1400
    set {hoes::3::tokens} to 3
    set {hoes::3::level} to 5



    set {hoes::4} to unbreakable wooden hoe named "<#a4632d>Decayed Wooden Harvester" with lore "&8Common ★☆☆☆☆☆☆" and " " and " &8• <#F48566>Blast: &f%{hoes::4::blast} + 1% block" and " &8&l| <#45CF30>Mult: &fx%{hoes::4::mult}%"
    wait 1 tick
    set {hoes::4::blast} to 0
    set {hoes::4::mult} to 1.11

    set {hoes::4::price} to 1800
    set {hoes::4::tokens} to 5
    set {hoes::4::level} to 10



    set {hoes::5} to unbreakable wooden hoe named "<#A4722D>Wooden Harvester" with lore "&8Common ★☆☆☆☆☆☆" and " " and " &8• <#F48566>Blast: &f%{hoes::5::blast} + 1% block" and " &8&l| <#45CF30>Mult: &fx%{hoes::5::mult}%"
    wait 1 tick
    set {hoes::5::blast} to 0
    set {hoes::5::mult} to 1.13

    set {hoes::5::price} to 2500
    set {hoes::5::tokens} to 5
    set {hoes::5::level} to 18



    set {hoes::6} to unbreakable wooden hoe named "<#9c7135>Hard Wood Harvester" with lore "&8Common ★☆☆☆☆☆☆" and " " and " &8• <#F48566>Blast: &f%{hoes::6::blast} + 1% block" and " &8&l| <#45CF30>Mult: &fx%{hoes::6::mult}%"
    wait 1 tick
    set {hoes::6::blast} to 0
    set {hoes::6::mult} to 1.15

    set {hoes::6::price} to 3100
    set {hoes::6::tokens} to 6
    set {hoes::6::level} to 23



    set {hoes::7} to unbreakable wooden hoe named "<#ffe030>Sun Dried Harvester" with lore "&8Common ★☆☆☆☆☆☆" and " " and " &8• <#F48566>Blast: &f%{hoes::7::blast} + 1% block" and " &8&l| <#45CF30>Mult: &fx%{hoes::7::mult}%"
    wait 1 tick
    set {hoes::7::blast} to 0
    set {hoes::7::mult} to 1.18

    set {hoes::7::price} to 3750
    set {hoes::7::tokens} to 6
    set {hoes::7::level} to 26


    # dont forget to change the value on the lore
    set {hoes::8} to unbreakable wooden hoe named "<#b59567>Artificial Wooden Harvester" with lore "&8Uncommon ★★☆☆☆☆☆" and " " and " &8• <#F48566>Blast: &f%{hoes::8::blast} + 1% block" and " &8&l| <#45CF30>Mult: &fx%{hoes::8::mult}%"
    wait 1 tick
    set {hoes::8::blast} to 0
    set {hoes::8::mult} to 1.2

    set {hoes::8::price} to 4075
    set {hoes::8::tokens} to 6
    set {hoes::8::level} to 30

    # dont forget to change the value on the lore
