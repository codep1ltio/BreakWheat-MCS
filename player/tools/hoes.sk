    set {hoes::10::tokens} to 7
    set {hoes::10::level} to 38

    # dont forget to change the value on the lore
    set {hoes::11} to unbreakable stone hoe named "<#a8a8a8>Limestone Harvester" with lore "&8Uncommon ★★☆☆☆☆☆" and " " and " &8• <#F48566>Blast: &f%{hoes::11::blast} + 1% block" and " &8&l| <#45CF30>Mult: &fx%{hoes::11::mult}%"
    wait 1 tick
    set {hoes::11::blast} to 0
    set {hoes::11::mult} to 1.60

    set {hoes::11::price} to 6000
    set {hoes::11::tokens} to 8
    set {hoes::11::level} to 42

    # dont forget to change the value on the lore
    set {hoes::12} to unbreakable stone hoe named "<#a8a8a8>Stone Harvester" with lore "&8Uncommon ★★☆☆☆☆☆" and " " and " &8• <#F48566>Blast: &f%{hoes::12::blast} + 1% block" and " &8&l| <#45CF30>Mult: &fx%{hoes::12::mult}%"
    wait 1 tick
